# Generate independent random values; do not deploy these literal examples.
ASD_SPLIT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
ASD_MANAGEMENT_API_KEY=replace-with-a-random-management-api-key
ASD_INTAKE_API_KEY=replace-with-a-random-intake-api-key
ASD_POSTGRES_PASSWORD=replace-with-a-random-postgres-password
ASD_REDIS_PASSWORD=replace-with-a-random-redis-password

# Optional MCP classifier. Leave MODEL_URI blank to use the other model routes.
MODEL_URI=
MCP_SERVER_PRIMARY_URL=ws://host.docker.internal:8085/mcp
MCP_SERVER_PRIMARY_AUTH_TOKEN=
MCP_SERVER_PRIMARY_TIMEOUT=10
